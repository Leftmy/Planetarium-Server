# ==========================
# Application Configuration
# ==========================
APP_PORT=8080

# ==========================
# Database Configuration
# ==========================
# These values are read both by the app and by docker compose.
# DB_HOST applies when running the API on the host (go run ./cmd/api);
# under docker compose the app talks to the "db" service instead.
DB_USER=postgres
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=planetarium_db

# ==========================
# Auth Configuration
# ==========================
# JWT_SECRET signs access tokens. Leaving it unset falls back to a published
# development value and logs a warning at startup — never deploy with that.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Access tokens are short because they cannot be revoked; refresh tokens are
# long because they can. Both take Go duration strings ("15m", "720h").
ACCESS_TTL=15m
REFRESH_TTL=720h
