# ==========================
# Application Configuration
# ==========================
APP_PORT=8080

# ==========================
# Database Configuration
# ==========================
# These values are read both by the app and by docker compose.
# DB_HOST applies when running the API on the host (go run ./cmd/api);
# under docker compose the app talks to the "db" service instead.
DB_USER=postgres
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=planetarium_db
